{
  "compilerOptions": {
    "target": "ES2017",
    "module": "none",
    "lib": ["DOM", "ES2017"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "removeComments": true,
    "noEmitOnError": false,
    "allowJs": false
  },
  "include": ["src/**/*"]
}
